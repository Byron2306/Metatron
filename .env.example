# Copy to `.env` and adjust as needed.
#   cp .env.example .env
#
# Docker Compose uses defaults for most values; only set what you need.

# Bind services to localhost by default (recommended for dev).
BIND_BACKEND_HOST=127.0.0.1
BIND_PRESENCE_HOST=127.0.0.1
BIND_MONGODB_HOST=127.0.0.1

# Backend auth / integration
INTEGRATION_API_KEY=dev-integration-key-change-me
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: Elasticsearch / SIEM
ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=

# Optional: Local LLM
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=mistral
OLLAMA_HOST_PORT=11435
NGINX_HTTP_PORT=8088
NGINX_HTTPS_PORT=8443
LOCAL_LLM_ENABLED=true
PRESENCE_OLLAMA_MODEL=qwen2.5:3b

# Optional: Cuckoo sandbox
CUCKOO_API_URL=http://cuckoo:8090
CUCKOO_API_TOKEN=
CUCKOO_API_VERSION=2

# Optional: Notifications / integrations
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=
SLACK_WEBHOOK_URL=
INTEGRATION_RUNTIME_MAX_CONCURRENT=1
AMASS_TIMEOUT_MINUTES=2

# Optional integration service ports / credentials
BIND_SPIDERFOOT_HOST=127.0.0.1
BIND_BLOODHOUND_HOST=127.0.0.1
BIND_NEO4J_HOST=127.0.0.1
BIND_NEO4J_BOLT_HOST=127.0.0.1
BIND_FLEET_HOST=127.0.0.1
NEO4J_AUTH=neo4j/bloodhound
FLEET_MYSQL_ROOT_PASSWORD=fleet-root
FLEET_MYSQL_PASSWORD=fleet
FLEET_AUTH_JWT_KEY=dev-fleet-jwt-change-me

# Optional: FleetDM
FLEET_BASE_URL=
FLEET_API_TOKEN=

# Optional: VPN
VPN_SERVER_ENDPOINT=vpn.yourdomain.com
WIREGUARD_SERVER_PORT=51820
WIREGUARD_HOST_PORT=51820
VPN_ENABLED=true

# Unified agent throttles. Defaults are intentionally quiet for local dashboards.
SERAPH_AGENT_UPDATE_INTERVAL=300
SERAPH_AGENT_HEARTBEAT_INTERVAL=300
SERAPH_AGENT_MONOLITHIC_LOOP=false
SERAPH_AGENT_INITIAL_LAN_DISCOVERY=false
SERAPH_AGENT_NETWORK_SCANNING=false
SERAPH_AGENT_WIRELESS_SCANNING=false
SERAPH_AGENT_BLUETOOTH_SCANNING=false
SERAPH_AGENT_USB_MONITORING=false
SERAPH_AGENT_AI_ANALYSIS=false
SERAPH_AGENT_VNS_SYNC=false
SERAPH_AGENT_THREAT_HUNTING=false
SERAPH_AGENT_AUTO_REMEDIATE=false
SERAPH_AGENT_VPN_AUTO_CONFIGURE=false
