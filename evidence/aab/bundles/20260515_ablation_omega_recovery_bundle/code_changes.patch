+        pressure = (
+            cbr_norm * w["cbr"]
+            + tbcr_norm * w["tbcr"]
+            + cdi_norm * w["cdi"]
+            + agenticity_norm * w["agenticity"]
+        )
+        pressure = max(0.0, min(1.0, pressure))
+
