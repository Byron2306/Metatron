VM_NAME=metatron-winval-clean-01
VM_RAM_MB=4096
VM_VCPUS=2
VM_DISK_GB=80

# Required: point to a Windows installation ISO you already have access to.
WINDOWS_ISO_PATH=/absolute/path/to/Windows.iso

# Optional libvirt settings.
VIRT_NETWORK=default
WINDOWS_HOSTNAME=WINVAL01

# Optional overrides if your distro places OVMF elsewhere.
OVMF_CODE=/usr/share/OVMF/OVMF_CODE_4M.fd
OVMF_VARS_TEMPLATE=/usr/share/OVMF/OVMF_VARS_4M.fd