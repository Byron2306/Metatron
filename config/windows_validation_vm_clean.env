VM_NAME=metatron-winval-clean-01
VM_RAM_MB=4096
VM_VCPUS=2
VM_DISK_GB=80

# Set this to a libvirt-readable Microsoft Windows 11 ISO location.
WINDOWS_ISO_PATH=/var/lib/libvirt/boot/Win11_25H2_English_x64_v2.iso

# Leave unset for a clean ISO install.
# WINDOWS_IMPORT_DISK_PATH=

VIRT_NETWORK=default
WINDOWS_HOSTNAME=WINVAL01

OVMF_CODE=/usr/share/OVMF/OVMF_CODE_4M.fd
OVMF_VARS_TEMPLATE=/usr/share/OVMF/OVMF_VARS_4M.fd
