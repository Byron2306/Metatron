VM_NAME=metatron-winval-01
VM_RAM_MB=4096
VM_VCPUS=2
VM_DISK_GB=80
VIRT_NETWORK=default
WINDOWS_HOSTNAME=WINVAL01

# Official Microsoft developer VM archive download target.
WINDOWS_DEV_ARCHIVE_PATH=/home/byron/Downloads/windows-vm-downloads/WinDev2407Eval.HyperV.zip
WINDOWS_DEV_EXTRACT_DIR=/home/byron/Downloads/windows-vm-downloads/WinDev2407Eval.HyperV

# Either set a Windows ISO or let the import script prepare this qcow2 disk.
# WINDOWS_ISO_PATH=/absolute/path/to/Windows.iso
WINDOWS_IMPORT_DISK_PATH=/var/lib/libvirt/images/metatron-winval-01.qcow2

OVMF_CODE=/usr/share/OVMF/OVMF_CODE_4M.fd
OVMF_VARS_TEMPLATE=/usr/share/OVMF/OVMF_VARS_4M.fd