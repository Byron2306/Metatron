# Atomic Red Team Configuration
ATOMIC_VALIDATION_ENABLED=true
ATOMIC_RUNNER=/usr/bin/pwsh
# Path must point to the atomics/ subfolder so Invoke-AtomicTest -PathToAtomicsFolder resolves T1xxx dirs
ATOMIC_RED_TEAM_PATH=/opt/atomic-red-team/atomics
PWSH_MODULE_PATH=/opt/invoke-atomicredteam/Invoke-AtomicRedTeam
ATOMIC_POWERSHELL_CONFIG=config/atomic_powershell.yml
MITRE_RESTORE_LEGACY_BASELINE=false
MITRE_PROMOTE_S4_TO_S5=false

# Atomic Sandbox — sibling container isolation for atomic test execution.
# These must be HOST-side absolute paths (the Docker socket spawns containers
# on the host, so it needs paths the host can resolve, not container-internal paths).
ATOMIC_SANDBOX_IMAGE=seraph-sandbox-tools:latest
ATOMIC_RED_TEAM_HOST_PATH=/home/byron/Downloads/Metatron-triune-outbound-gate/atomic-red-team
INVOKE_ATOMICREDTEAM_HOST_PATH=/home/byron/Downloads/Metatron-triune-outbound-gate/tools/invoke-atomicredteam
ATOMIC_VALIDATION_VOLUME=metatron-triune-outbound-gate_atomic_validation_reports

