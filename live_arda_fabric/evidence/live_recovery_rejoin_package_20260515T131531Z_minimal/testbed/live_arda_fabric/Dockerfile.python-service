FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_MODULE=asset_app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl tcpdump iproute2 wireguard-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY controller_app.py asset_app.py /app/
RUN pip install --no-cache-dir fastapi==0.115.6 uvicorn[standard]==0.34.0

CMD ["sh", "-lc", "uvicorn ${APP_MODULE}:app --host 0.0.0.0 --port 8080"]
